<% layout("/layouts/boilerplate") %>

<div class="row mt-5 mb-5">
    <div class="col-md-6 offset-md-3 col-lg-5 mx-auto">
        <div class="card shadow border-0 p-4" style="border-radius: 1rem;">
            <h2 class="text-center mb-4 fw-bold" style="color: #222;">Signup on Wanderlust</h2>
            
            <form action="/signup" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label text-muted">Username</label>
                    <input name="username" id="username" type="text" class="form-control rounded-pill px-3 py-2" required />
                    <div class="valid-feedback">Looks good!</div>
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label text-muted">Email</label>
                    <input name="email" id="email" type="email" class="form-control rounded-pill px-3 py-2" required />
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label text-muted">Password</label>
                    <input name="password" id="password" type="password" class="form-control rounded-pill px-3 py-2" required />
                </div>

                <button class="btn w-100 rounded-pill py-2 mt-3 text-white fw-bold" style="background-color: #fe424d; border: none; transition: background-color 0.2s;">
                    Sign up
                </button>
            </form>

            <p class="text-center text-muted mt-3 mb-0" style="font-size: 0.9rem;">
                Already have an account? <a href="/login" style="color: #fe424d; text-decoration: none; font-weight: 600;">Log in</a>
            </p>
        </div>
    </div>
</div>