<% layout("layouts/boilerplate") %> 

    <style>
       .tax-info {
        display: none;
       }

       .tax-toggle {
        border: 1px solid #ddd;
        border-radius: 1rem;
        height: 3rem;
        padding: 0.5rem 1rem;
        display: flex;
        align-items: center;
        background-color: #fff;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.02);
       }
    </style>

    <div class="d-flex justify-content-end align-items-center mt-3 mb-2">
      <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
          <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" role="switch" style="cursor: pointer;">
          <label class="form-check-label" for="flexSwitchCheckDefault" style="cursor: pointer; font-size: 0.9rem;">Display total after taxes</label>
        </div>
      </div>
    </div>

    <!-- No Results Message (Hidden by default) -->
    <div id="no-results" class="text-center mt-5" style="display: none;">
      <h3>No listings found matching your search!</h3>
      <p class="text-muted">Try searching for another destination or title.</p>
    </div>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3" id="listings-container">
        <% for(let listing of allListings) { %>
          <a href="/listings/<%= listing._id %>" class="listing-link search-item" data-title="<%= listing.title.toLowerCase() %>" data-location="<%= listing.location.toLowerCase() %>">
            <div class="card col listing-card">
              <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem"/>
              <div class="card-img-overlay"></div>
              <div class="card-body">
                <p class="card-text">
                 <b> <%= listing.title %> </b> <br>
                 &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                 <i class="tax-info"> &nbsp; &nbsp; +18% GST</i>
                </p>
              </div>
            </div>
          </a>
      <% } %>
    </div>

<script>
  // Tax Toggle Logic
  let taxSwitch = document.getElementById("flexSwitchCheckDefault");
  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");
    for(info of taxInfo) {
      if(info.style.display != "inline") {
         info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }
  }); 

  // Live Instant Search Logic
  const searchInput = document.getElementById("search-input");
  const searchItems = document.querySelectorAll(".search-item");
  const noResultsDiv = document.getElementById("no-results");

  searchInput.addEventListener("input", (e) => {
    const query = e.target.value.toLowerCase().trim();
    let visibleCount = 0;

    searchItems.forEach(item => {
      const title = item.getAttribute("data-title");
      const location = item.getAttribute("data-location");

      if (title.includes(query) || location.includes(query)) {
        item.style.display = "block";
        visibleCount++;
      } else {
        item.style.display = "none";
      }
    });

    // Show/Hide no results warning
    if (visibleCount === 0) {
      noResultsDiv.style.display = "block";
    } else {
      noResultsDiv.style.display = "none";
    }
  });
</script>